PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Required in production. Generate a unique 48-byte random secret; never commit it.
SESSION_SECRET=
# Optional in development; mandatory in production.
MONGODB_URI=
MAX_ROOMS=10
SHUTDOWN_GRACE_MS=240000
# Optional Google login. Register API_ORIGIN/auth/google/callback as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set a separate random token to enable /api/admin operations.
ADMIN_TOKEN=
# Only set when the actual trusted proxy topology is known.
TRUST_PROXY=0
# Development-only file persistence. Production always uses MongoDB.
DATA_DIR=.local-data
